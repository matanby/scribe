{
  "name": "scribe",
  "version": "1.0.0",
  "description": "Apple Notes style WYSIWYG Markdown Editor with Native Hebrew/English RTL",
  "author": "Matan Ben-Yosef",
  "homepage": "https://github.com/matanby/scribe",
  "repository": {
    "type": "git",
    "url": "https://github.com/matanby/scribe.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "tsc && vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "preview": "vite preview",
    "test": "npm run test:fs && npm run test:protocol && npm run test:bidi",
    "test:fs": "tsx electron/fileSystem.test.ts",
    "test:protocol": "esbuild electron/assetProtocol.test.ts --bundle --platform=node --format=cjs --external:electron --external:chokidar --external:gray-matter --outfile=dist-electron/assetProtocol.test.cjs && electron dist-electron/assetProtocol.test.cjs",
    "test:bidi": "tsx electron/bidi.test.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-typography": "^2.11.5",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "fuse.js": "^7.5.0",
    "katex": "^0.18.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.16.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tiptap-markdown": "^0.8.10",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.scribe.notes",
    "productName": "Scribe",
    "afterPack": "./electron/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/preload.js",
      "public/icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/chokidar/**"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "electronLanguages": [
      "en",
      "en_GB",
      "he"
    ]
  }
}
